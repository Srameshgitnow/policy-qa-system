{
  "name": "policy-qa-system",
  "version": "0.1.0",
  "description": "RAG system for UK government policy questions",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "build": "npm run build --workspaces",
    "start": "npm start --workspaces",
    "db:migrate": "cd backend && npm run db:migrate",
    "seed:policies": "cd backend && npm run seed:policies",
    "ingest:documents": "cd backend && npm run ingest:documents"
  }
}
