{
  "name": "policy-qa-backend",
  "version": "0.1.0",
  "description": "Backend API for policy Q&A system",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node --import tsx src/db/migrations/run.ts",
    "seed:policies": "node --import tsx src/db/seeds/policies.ts",
    "ingest:documents": "node --import tsx src/rag/ingestion/ingest.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.1.17",
    "@langchain/openai": "^0.0.16",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "langchain": "^0.0.200",
    "pg": "^8.11.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/pg": "^8.10.7",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  }
}
